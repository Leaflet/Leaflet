{
  "name": "leaflet",
  "version": "2.0.0-beta.3",
  "homepage": "https://leafletjs.com/",
  "description": "JavaScript library for mobile-friendly interactive maps",
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint/css": "^2.0.1",
    "@mourner/yeahml": "1.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-mourner": "^5.0.2",
    "eslint-plugin-baseline-js": "^0.7.7",
    "eslint-plugin-html": "^8.2.1",
    "husky": "^9.1.7",
    "leafdoc": "^2.4.0",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "liquidjs": "10.30.1",
    "marked": "18.1.3",
    "marked-smartypants": "1.1.12",
    "playwright": "^1.65.0",
    "rolldown": "^1.3.0",
    "shiki": "4.6.0",
    "sinon": "^22.1.0",
    "typescript": "7.1.0-beta",
    "ui-event-simulator": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/Leaflet.js"
    },
    "./dist/leaflet.css": "./dist/leaflet.css",
    "./styles.css": "./dist/leaflet.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "types": "dist/types/index.d.ts",
  "style": "dist/leaflet.css",
  "files": [
    "dist",
    "src",
    "!dist/leaflet.zip",
    "!*.leafdoc",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "debug": "node build/serve.js",
    "test": "vitest run",
    "test:ui": "vitest --ui --browser.headless=false",
    "coverage": "vitest run --coverage",
    "build": "npm run build:js && npm run build:types",
    "build:js": "rolldown --config build/rolldown-config.js",
    "build:types": "tsc",
    "watch": "npm run build:js -- --watch",
    "zip": "npm run build && rm -f dist/leaflet.zip && zip -j dist/leaflet.zip dist/leaflet* CHANGELOG.md MIGRATION.md LICENSE README.md",
    "lint": "eslint . --cache",
    "lintfix": "npm run lint -- --fix",
    "lint:docs": "node build/docs-audit.js",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p spec/types",
    "site": "node build/site.js",
    "serve": "node build/serve.js --site",
    "preview": "node build/serve.js --site --preview",
    "pin-release": "node build/pin-release.js",
    "prepare": "husky",
    "version": "node build/version.js && git add src/Leaflet.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Leaflet/Leaflet.git"
  },
  "keywords": [
    "gis",
    "map"
  ],
  "license": "BSD-2-Clause",
  "lint-staged": {
    "*.{js,mjs,md,css}": "eslint --cache --fix"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16"
  }
}
