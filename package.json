{
  "name": "leaflet",
  "version": "2.0.0-alpha.1",
  "homepage": "https://leafletjs.com/",
  "description": "JavaScript library for mobile-friendly interactive maps",
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/css": "^2.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-mourner": "^5.0.1",
    "eslint-plugin-baseline-js": "^0.7.5",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "leafdoc": "^2.4.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prosthetic-hand": "^2.2.2",
    "rollup": "^4.64.9",
    "sinon": "^22.1.0",
    "ui-event-simulator": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "exports": {
    ".": "./src/Leaflet.js",
    "./styles.css": "./dist/leaflet.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "style": "dist/leaflet.css",
  "files": [
    "dist",
    "src",
    "!dist/leaflet.zip",
    "!*.leafdoc",
    "CHANGELOG.md"
  ],
  "scripts": {
    "debug": "http-server -c-1",
    "docs": "node ./build/docs.js && node ./build/integrity.js",
    "test": "vitest run --project=chromium",
    "test:ui": "vitest --project=chromium --ui --browser.headless=false",
    "coverage": "vitest run --project=chromium --coverage",
    "build": "rollup --config build/rollup-config.js",
    "watch": "npm run build -- --watch",
    "lint": "eslint . --cache",
    "lintfix": "npm run lint -- --fix",
    "serve": "cd docs && bundle exec jekyll serve",
    "prepare": "husky",
    "version": "node build/version.js && git add src/Leaflet.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Leaflet/Leaflet.git"
  },
  "keywords": [
    "gis",
    "map"
  ],
  "license": "BSD-2-Clause",
  "lint-staged": {
    "*.(js|mjs|md)": "eslint --cache --fix"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
