<section{% if section.secondary %} class='collapsable'{% endif %}>
{%- if section.name and inherited != true %}
<h4 id='{{ section.id }}'>{{ section.name | escape }}</h4>
{%- endif %}
{%- if section.comments %}
<div class='section-comments'>{{ section.comments | markdown }}</div>
{%- endif %}
{%- if kind == 'example' %}
{%- for item in section.items %}
{{ item.comments | markdown: true }}
{%- endfor %}
{%- else %}
{%- assign c = columns[kind] %}
<table><thead>
	<tr>
		<th>{{ c.name }}</th>
		{%- if c.type %}
		<th>{{ c.type }}</th>
		{%- endif %}
		{%- if c.default %}
		<th>{{ c.default }}</th>
		{%- endif %}
		<th>Description</th>
	</tr>
	</thead><tbody>
	{%- for item in section.items %}
	<tr id='{{ item.id }}'>
		<td><a class='permalink' href='#{{ item.id }}' aria-label='Permalink'></a><code><b>{% if kind == 'constructor' %}new {% endif %}{{ item.name | escape }}</b>
			{%- if c.params %}{{ item | signature: c.returns }}{% endif %}</code></td>
		{%- if c.type %}
		<td><code>{{ item.type | type }}</code></td>
		{%- endif %}
		{%- if c.default %}
		<td><code>{{ item.default | escape }}</code></td>
		{%- endif %}
		<td>{{ item.comments | markdown: c.block }}</td>
	</tr>
	{%- endfor %}
</tbody></table>
{%- endif %}
</section>
