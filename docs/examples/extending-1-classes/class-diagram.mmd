	Layer <|-- DivOverlay
	Layer <|-- ImageOverlay

	Icon <|-- DefaultIcon
	Icon <|-- DivIcon

	GridLayer <|-- TileLayer
	TileLayer <|-- WMSTileLayer

	Renderer <|-- Canvas
	Renderer <|-- SVG
	Path ..> Renderer : drawn in a
	Path <|-- CircleMarker
	CircleMarker <|-- Circle
	Path <|-- Polyline
	Polyline <|-- Polygon
	Polygon <|-- Rectangle

	LayerGroup <|-- FeatureGroup
	FeatureGroup <|-- GeoJSON

	DivOverlay <|-- Popup
