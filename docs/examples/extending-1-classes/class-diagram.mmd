config:
  class:
    hideEmptyMembersBox: true
---
classDiagram
	%% Rendered to class-diagram.svg with pele (https://pele.run): render(source, {responsive: false, padding: 16})
	class Class {
		options
		include()
		mergeOptions()
		addInitHook()
	}
	class Evented {
		on()
		off()
		fire()
	}
	class LeafletMap {
		addLayer()
		removeLayer()
		addControl()
		removeControl()
		addHandler()
	}
	class Layer {
		onAdd()
		onRemove()
		getEvents()
		getAttribution()
		beforeAdd()
	}
	class Control {
		onAdd()
		onRemove()
	}
	class Handler {
		addHooks()
		removeHooks()
	}
	class GridLayer {
		createTile()
	}
	class TileLayer {
		getTileUrl()
	}
	class LatLng {
		lat
		lng
	}
	class Point {
		x
		y
	}
	class Controls["AttributionControl<br>LayersControl<br>ScaleControl<br>ZoomControl"]
	class Handlers["BoxZoomHandler<br>DoubleClickZoomHandler<br>DragHandler<br>KeyboardHandler<br>PinchZoomHandler<br>ScrollWheelZoomHandler"]
	class EarthCRSs["EPSG3395<br>EPSG3857<br>EPSG4326"]

	Class <|-- Evented
	Class <|-- Control
	Class <|-- Handler
	Class <|-- Icon
	Evented <|-- LeafletMap
	Evented <|-- Layer

